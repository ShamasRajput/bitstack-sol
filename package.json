{
  "name": "bitstack-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Bitstack Solutions agency website built with Next.js, TypeScript, Tailwind, Framer Motion and Lenis",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/inquiries.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src next.config.ts tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "framer-motion": "^14.3.0",
    "lenis": "^1.3.27",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
